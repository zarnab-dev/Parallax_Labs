{
  "name": "ecommerce-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade e-commerce storefront built incrementally as a frontend internship project.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "msw:init": "msw init public/ --save",
    "prebuild": "node scripts/generate-sw.mjs",
    "analyze": "ANALYZE=true next build",
    "budget": "node scripts/check-bundle-budgets.mjs",
    "lhci": "lhci autorun",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@xstate/react": "4.1.3",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "xstate": "5.18.2"
  },
  "devDependencies": {
    "@lhci/cli": "0.14.0",
    "@next/bundle-analyzer": "14.2.35",
    "@storybook/addon-a11y": "8.2.9",
    "@storybook/addon-essentials": "8.2.9",
    "@storybook/addon-interactions": "8.2.9",
    "@storybook/addon-links": "8.2.9",
    "@storybook/blocks": "8.2.9",
    "@storybook/nextjs": "8.2.9",
    "@storybook/react": "8.2.9",
    "@storybook/test": "8.2.9",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.169.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "msw": "2.4.9",
    "msw-storybook-addon": "2.0.3",
    "postcss": "8.4.41",
    "storybook": "8.2.9",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vitest": "2.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
